# Local development settings. Copy to .env and adjust.
# Production values are set as environment variables on the host (never in this file):
# ENVIRONMENT=production, a strong JWT_SECRET_KEY, real Upstash credentials and Brevo email.
# Outside development the app refuses to start with the default JWT secret or EMAIL_PROVIDER=mock.

# Application
APP_NAME=DukaanFlow API
# "development" enables the unauthenticated /api/v1/dev/* endpoints and the mock email provider.
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (SQLAlchemy URL using the psycopg 3 driver).
# Percent-encode special characters in the password, e.g. "@" -> "%40", "#" -> "%23".
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dukaanflow

# Connection pool (optional; defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=5

# Test database (optional). Default: same server, database name + "_test".
# It is created if missing and wiped/rebuilt by every pytest run. Never point it at real data.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dukaanflow_test

# JWT access tokens. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Upstash Redis (OTPs and login rate limits) - from the Upstash console, "REST API" section.
# Required for both OTP and password login.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# OTP email delivery (retailers enter their phone; the OTP goes to the account's email).
#   mock   development only: the OTP is written to the backend console, no email is sent
#   brevo  real email through Brevo transactional email (required outside development)
EMAIL_PROVIDER=mock
# Brevo: dashboard -> SMTP & API -> API keys. The sender must be verified in Brevo (Senders).
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=DukaanFlow

# AI order capture: OpenAI API key and model (Structured Outputs). Leave the key empty to
# disable AI capture (the endpoint then returns 503 AI_NOT_CONFIGURED).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_SECONDS=30
# Voice notes are transcribed with this model before being read like a text message.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Product images (Cloudinary, admin upload). Without these, products show local placeholders.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=dukaanflow/products

# Authentication limits (optional; defaults shown)
# OTP_EXPIRE_SECONDS=120
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_REQUESTS=5
# OTP_REQUEST_WINDOW_SECONDS=900
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=900

# Development only: password for the seeded internal users (admin, order desk, salesmen).
# Applied by `python -m seed.run_seed` to demo users that have no password yet.
# DEMO_STAFF_PASSWORD=choose-a-local-demo-password
